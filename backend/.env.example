# PostgreSQL
# Option A — full connection string (e.g. Supabase / Neon / Railway Postgres).
# Takes priority over the DB_* fields below. Supabase example:
#   postgresql+asyncpg://postgres:YOURPASSWORD@db.xxxx.supabase.co:5432/postgres?ssl=require
# or using the Supabase connection pooler:
#   postgresql+asyncpg://postgres.xxxx:YOURPASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&ssl=require
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@host:5432/disaster_db?ssl=require

# Option B — individual fields (default local dev):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disaster_db
DB_USER=postgres
DB_PASSWORD=postgres
# Set DB_SSL=true when the DB is remote and requires TLS (Supabase does).
DB_SSL=false

# JWT
JWT_SECRET=CHANGE_ME_use_a_long_random_string_in_production
JWT_EXPIRY_MINUTES=1440

# OSRM routing proxy
OSRM_URL=https://router.project-osrm.org/route/v1/driving
ROUTE_TIMEOUT_SECONDS=3
EMERGENCY_AVG_SPEED_KMPH=30

# Server
HOST=0.0.0.0
PORT=8000

# CORS
# Requester app, Team app, Authority dashboard (add your deployed Vercel URLs in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
